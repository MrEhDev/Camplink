# Aquí defino las variables de entorno de ejemplo para Camplink

# Clave secreta de Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-segura-en-produccion
DJANGO_DEBUG=True

# Clave de Google Maps Directions API (Opcional, el backend tiene fallback automático con OSRM y Haversine)
GOOGLE_MAPS_API_KEY=

# URL de Webhook para despliegue en Render (Opcional para GitHub Actions)
RENDER_DEPLOY_HOOK_URL=