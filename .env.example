# Aquí defino las variables de entorno de ejemplo para Camplink

# Clave secreta de Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-segura-en-produccion
DJANGO_DEBUG=True

# Clave de Google Maps Directions API (Opcional, el backend tiene fallback automático con OSRM y Haversine)
GOOGLE_MAPS_API_KEY=

# URL de Webhook para despliegue en Render (Opcional para GitHub Actions)
RENDER_DEPLOY_HOOK_URL=

# ==========================================
# Configuración de Envío de Correos (SMTP)
# ==========================================
# Si se completan EMAIL_HOST_USER y EMAIL_HOST_PASSWORD, el sistema enviará correos reales
# (códigos de confirmación de cuenta, recuperación de contraseña, notificaciones).
# Dejar vacío para que los correos se impriman en la consola de Django.

# Servidor SMTP (Ejemplos: smtp.gmail.com | smtp.sendgrid.net | smtp-relay.brevo.com | smtp.office365.com)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Cuenta de correo remitente
EMAIL_HOST_USER=camplink.app.info@gmail.com

# Contraseña de aplicación (Para Gmail: Contraseña de Aplicación de 16 caracteres generada en tu cuenta de Google)
EMAIL_HOST_PASSWORD=ryuu rpur jxyj halp

# Nombre y dirección de remitente mostrada al usuario
DEFAULT_FROM_EMAIL=Camplink <camplink.app.info@gmail.com>
